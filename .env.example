# GOD — Environment Variables
# Copy to .env and fill in your API keys.
# At least one LLM provider key is required for AI features.

# ═══════════════════════════════
# LLM PROVIDERS (at least one required)
# ═══════════════════════════════
GROQ_API_KEY=
CEREBRAS_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=
INFERENCE_API_KEY=
ZAI_API_KEY=

# ═══════════════════════════════
# OPTIONAL
# ═══════════════════════════════
# Worker authentication token for remote workers
SUPERAI_WORKER_TOKEN=

# GOD operating mode: auto, offline, normal, conservative, token_saver
GOD_MODE=auto

# Benchmark run permission (set to 'true' to allow via API)
BENCHMARK_RUN=
